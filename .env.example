# =============================================================================
# AI CONTENT STUDIO - biến môi trường mẫu
# Sao chép thành .env ở thư mục gốc:   Copy-Item .env.example .env   (PowerShell)
#                                       cp .env.example .env         (WSL2/bash)
# KHÔNG commit file .env. File này chỉ chứa giá trị mẫu cho môi trường LOCAL.
# =============================================================================

# ----- Chung -----------------------------------------------------------------
NODE_ENV=development
# Thời gian luôn lưu UTC; múi giờ dưới đây chỉ dùng để HIỂN THỊ
APP_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
APP_DEFAULT_LOCALE=vi-VN
LOG_LEVEL=debug

# ----- Web (Next.js) ---------------------------------------------------------
WEB_PORT=3000
# Địa chỉ API mà SERVER của Next.js gọi tới (không lộ ra trình duyệt)
API_INTERNAL_URL=http://127.0.0.1:4000
# Biến NEXT_PUBLIC_* sẽ bị đóng gói vào bundle client -> TUYỆT ĐỐI không đặt secret ở đây
NEXT_PUBLIC_APP_NAME=AI CONTENT STUDIO

# ----- API (NestJS) ----------------------------------------------------------
API_PORT=4000
# Chỉ nghe trên máy cục bộ: API CHƯA có xác thực (dự kiến Phase 09)
API_HOST=127.0.0.1
# Origin được phép gọi API (CORS), phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000

# ----- Truy cập & workspace (Phase 02) ---------------------------------------
# dev-local: mọi request được gán vào DEV_WORKSPACE_ID và CHỈ chấp nhận kết nối từ 127.0.0.1/::1.
# KHÔNG phải xác thực. API từ chối khởi động nếu NODE_ENV=production với chế độ này.
AUTH_MODE=dev-local
DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# ----- Media (Phase 02) ------------------------------------------------------
MEDIA_MAX_UPLOAD_MB=10
# Thời hạn URL upload presigned (giây)
MEDIA_UPLOAD_TTL_SEC=900
# Chu kỳ dọn upload bỏ dở & object mồ côi (giây, 0 = tắt)
MEDIA_CLEANUP_INTERVAL_SEC=600
# Tên miền được phép tải ảnh từ URL khi import (phân tách dấu phẩy). Rỗng = TẮT.
# Chỉ thêm nguồn bạn có quyền sử dụng ảnh. VD: cdn.cuahangcuaban.vn
IMPORT_IMAGE_ALLOWED_HOSTS=

# ----- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=acs
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=ai_content_studio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://acs:change_me_local_only@localhost:5432/ai_content_studio?schema=public

# ----- Redis / BullMQ --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=acs

# ----- MinIO (S3 compatible) -------------------------------------------------
MINIO_ROOT_USER=acs_minio
MINIO_ROOT_PASSWORD=change_me_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=acs_minio
S3_SECRET_ACCESS_KEY=change_me_local_only
S3_BUCKET=acs-media
S3_FORCE_PATH_STYLE=true
# Endpoint MinIO mà TRÌNH DUYỆT truy cập (presigned URL upload/xem ảnh). Để trống = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# ----- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_INTERVAL_MS=10000
# Đường dẫn tới ffmpeg. Để "ffmpeg" nếu đã có trong PATH, hoặc đường dẫn tuyệt đối
# Ví dụ Windows: C:\\ffmpeg\\bin\\ffmpeg.exe
FFMPEG_PATH=ffmpeg

# ----- AI providers (CHƯA dùng ở giai đoạn 00) -------------------------------
# Chỉ đọc ở server (api/worker). Không bao giờ thêm tiền tố NEXT_PUBLIC_.
# Để trống = provider bị vô hiệu hoá.
AI_SCRIPT_PROVIDER=
AI_IMAGE_PROVIDER=
AI_TTS_PROVIDER=
AI_VIDEO_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=

# ----- TikTok (CHƯA dùng ở giai đoạn 00) -------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/integrations/tiktok/callback

# ----- AI Script Engine (Phase 03) – chỉ ở server -----
# AI_SCRIPT_PROVIDER ở trên: provider mặc định khi workspace chưa chọn (anthropic | openai | mock)
ANTHROPIC_SCRIPT_MODEL=claude-opus-5-5
ANTHROPIC_SCRIPT_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# low | medium | high | xhigh | max
ANTHROPIC_SCRIPT_EFFORT=medium
# OpenAI: BẮT BUỘC đặt model (không có mặc định trong code). Thiếu đơn giá -> không cho tạo (không ước tính được chi phí).
OPENAI_SCRIPT_MODEL=
OPENAI_SCRIPT_MODELS=
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
OPENAI_SUPPORTS_TEMPERATURE=false
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_MAX_REPAIR_ATTEMPTS=1
AI_MAX_OUTPUT_TOKENS=12000
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONCURRENT_REQUESTS=4
# Mock provider (không gọi AI thật, nội dung có nhãn [MOCK]) – CHỈ dev/test, bị cấm khi NODE_ENV=production
AI_MOCK_PROVIDER_ENABLED=true