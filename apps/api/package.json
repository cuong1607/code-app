{
  "name": "@acs/api",
  "version": "0.0.0",
  "private": true,
  "description": "AI CONTENT STUDIO - NestJS API",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "dotenv run -q -f ../../.env -- prisma validate",
    "prisma:migrate": "dotenv run -q -f ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv run -q -f ../../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv run -q -f ../../.env -- prisma studio",
    "prisma:seed": "dotenv run -q -f ../../.env -- tsx prisma/seed.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "ai:image-smoke": "tsx scripts/image-smoke.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@acs/shared": "workspace:*",
    "@anthropic-ai/sdk": "^1.10.0",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@google/genai": "^3.6.1",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@prisma/client": "~6.19.3",
    "bullmq": "^5.81.5",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "image-size": "^2.1.0",
    "ioredis": "^5.11.1",
    "openai": "^7.60.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@acs/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.5",
    "prisma": "~6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
