{
  "name": "@acs/api",
  "version": "0.0.0",
  "private": true,
  "description": "AI CONTENT STUDIO - NestJS API",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "dotenv run -q -f ../../.env -- prisma validate",
    "prisma:migrate": "dotenv run -q -f ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv run -q -f ../../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv run -q -f ../../.env -- prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@acs/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@prisma/client": "~6.19.3",
    "bullmq": "^5.81.5",
    "dotenv": "^18.0.10",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@acs/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.5",
    "prisma": "~6.19.3",
    "supertest": "^7.3.2",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
