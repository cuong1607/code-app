{
  "extends": "@acs/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    ".next/types/**/*.ts",
    "*.ts",
    "*.mts",
    "*.mjs"
  ],
  "exclude": ["node_modules", ".next"]
}
